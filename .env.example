# AI Employee Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# SILVER TIER - Email & Communication
# ============================================

# Gmail API Credentials
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Email Configuration
EMAIL_CHECK_INTERVAL=300
EMAIL_FROM=your-email@gmail.com

# WhatsApp Configuration (Silver Tier)
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_PATH=AI_Employee_Vault/.state/whatsapp_session

# ============================================
# GOLD TIER - Odoo Accounting Integration
# ============================================

# Odoo Connection
ODOO_URL=http://localhost:8069
ODOO_DATABASE=gold_tier_accounting
ODOO_USERNAME=ai_employee
ODOO_PASSWORD=your_odoo_password_here

# Odoo Settings
ODOO_TIMEOUT=30
ODOO_RETRY_ATTEMPTS=3

# ============================================
# GOLD TIER - Facebook Integration
# ============================================

# Facebook App Credentials
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# Facebook Page Access
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token_here

# ============================================
# GOLD TIER - Instagram Integration
# ============================================

# Instagram Business Account
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Note: Instagram uses Facebook's Graph API
# The FACEBOOK_PAGE_ACCESS_TOKEN is used for Instagram as well

# ============================================
# GOLD TIER - Twitter Integration
# ============================================

# Twitter API Credentials (API v2)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ============================================
# GOLD TIER - Ralph Wiggum Autonomous Loop
# ============================================

# Autonomous Loop Settings
RALPH_WIGGUM_MAX_ITERATIONS=10
RALPH_WIGGUM_TIMEOUT_MINUTES=5
RALPH_WIGGUM_ENABLED=true

# ============================================
# GOLD TIER - MCP Server Configuration
# ============================================

# MCP Server Ports
ODOO_MCP_PORT=3100
FACEBOOK_MCP_PORT=3101
INSTAGRAM_MCP_PORT=3102
TWITTER_MCP_PORT=3103

# MCP Server API Keys (for authentication)
MCP_API_KEY=your_mcp_api_key_here

# ============================================
# GOLD TIER - Audit Logging
# ============================================

# Audit Log Settings
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_LOG_PATH=AI_Employee_Vault/Audit_Logs

# ============================================
# GOLD TIER - CEO Briefing
# ============================================

# CEO Briefing Schedule
CEO_BRIEFING_ENABLED=true
CEO_BRIEFING_DAY=Monday
CEO_BRIEFING_TIME=08:00
CEO_BRIEFING_PATH=AI_Employee_Vault/CEO_Briefings

# ============================================
# General Settings
# ============================================

# Timezone
TZ=America/New_York

# Debug Mode
DEBUG=false

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
